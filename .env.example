# 구글 시트 주소에서 /d/ 와 /edit 사이의 긴 문자열
GOOGLE_SHEET_ID=

# 서비스 계정 이메일 (JSON 파일의 client_email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 비밀키 (JSON 파일의 private_key). 줄바꿈은 \n 그대로 둡니다
GOOGLE_PRIVATE_KEY=

# 로그인 상태를 암호화할 임의의 긴 문자열 (아무 글자나 40자 이상)
SESSION_SECRET=

# 대표 계정 최초 로그인용 임시 비밀번호. 첫 로그인 후 바꾸면 더 이상 쓰이지 않습니다
ADMIN_INIT_PASSWORD=
